{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(yarn *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm rm *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm i)",
      "Bash(pnpm i *)",
      "Bash(pnpm dlx *)",
      "Bash(npx *)",
      "Bash(pnpm eval:run)",
      "Bash(pnpm eval:run *)",
      "Bash(pnpm kb:describe)",
      "Bash(pnpm kb:describe *)",
      "Bash(pnpm kb:index)",
      "Bash(pnpm kb:index *)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down -v *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ]
  }
}
