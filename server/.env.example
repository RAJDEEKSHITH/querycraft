# Server variables. Copy to server/.env and set real values. Loaded with Node's --env-file flag (or dotenv if the scaffold already uses it).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=0

# Databases
APP_DATABASE_URL=postgres://qc_app:change_me_app@localhost:5432/querycraft_app
READER_DATABASE_URL=postgres://qc_reader:change_me_reader@localhost:5432/adventureworks
# Used only by the test suite
TEST_APP_DATABASE_URL=postgres://qc_app:change_me_app@localhost:5432/querycraft_test

# Groq (chat, free tier)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional smaller model for the final answer step (has its own free-tier quota); empty = use LLM_MODEL
LLM_ANSWER_MODEL=openai/gpt-oss-20b

# Google Gemini (embeddings, free tier)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Prices in USD per 1M tokens (0 on free tiers; kept so cost reporting works on a paid tier)
LLM_INPUT_PRICE_PER_1M_USD=0
LLM_OUTPUT_PRICE_PER_1M_USD=0
EMBEDDING_PRICE_PER_1M_USD=0

# Provider rate-limit handling
PROVIDER_MAX_RETRIES=3
PROVIDER_MAX_WAIT_MS=30000

# Cost and abuse protection
# LLM tokens per day for the app + MCP (protects the shared free-tier quota)
DAILY_TOKEN_BUDGET=100000
# LLM tokens per day for evaluation runs (source eval; counted separately from the app + MCP budget)
EVAL_DAILY_TOKEN_BUDGET=100000
RATE_LIMIT_PER_MINUTE=10
QUESTION_MAX_LENGTH=500

# Query safety
QUERY_TIMEOUT_MS=5000
QUERY_ROW_LIMIT=500
# Postgres planner cost units from EXPLAIN; tuned in Milestone 4
QUERY_COST_SOFT_LIMIT=50000
QUERY_COST_HARD_LIMIT=500000

# Agent limits
MAX_SQL_ATTEMPTS=3
MAX_CLARIFICATIONS=2

# Admin (at least 32 random characters)
ADMIN_TOKEN=
