NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=0

# Databases
APP_DATABASE_URL=postgres://qc_app:change_me_app@localhost:5432/querycraft_app
READER_DATABASE_URL=postgres://qc_reader:change_me_reader@localhost:5432/adventureworks
# Used only by the test suite
TEST_APP_DATABASE_URL=postgres://qc_app:change_me_app@localhost:5432/querycraft_test

# OpenAI
OPENAI_API_KEY=
# Chat model used for SQL generation and answers (choose a current, low-cost OpenAI chat model)
LLM_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Prices in USD per 1M tokens (check the provider's current pricing)
LLM_INPUT_PRICE_PER_1M_USD=
LLM_OUTPUT_PRICE_PER_1M_USD=
EMBEDDING_PRICE_PER_1M_USD=

# Cost and abuse protection
DAILY_BUDGET_USD=3
RATE_LIMIT_PER_MINUTE=10
QUESTION_MAX_LENGTH=500

# Query safety
QUERY_TIMEOUT_MS=5000
QUERY_ROW_LIMIT=500
# Postgres planner cost units from EXPLAIN; tuned in Milestone 4
QUERY_COST_SOFT_LIMIT=50000
QUERY_COST_HARD_LIMIT=500000

# Agent limits
MAX_SQL_ATTEMPTS=3
MAX_CLARIFICATIONS=2

# Admin (at least 32 random characters)
ADMIN_TOKEN=
